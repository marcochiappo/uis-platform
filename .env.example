# Copy to .env.local. With no Supabase values set, the app runs in DEMO MODE.

# --- Mode -------------------------------------------------------------------
# "true" forces demo mode even if Supabase is configured; "false" requires Supabase.
UIS_DEMO_MODE=

# --- Supabase (required outside demo mode) -----------------------------------
# Project Settings → API. The publishable key is safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Used as a fallback origin for email confirmation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (optional; never used in demo mode) --------------------------------
# Introduction emails are sent through Resend only when BOTH are set.
RESEND_API_KEY=
EMAIL_FROM=

# --- Demo mode (optional) ---------------------------------------------------------
# Signs the demo session cookie. Set a random value if the demo is reachable by others.
DEMO_SESSION_SECRET=
# Where demo data is stored (default: .demo-data/db.json).
DEMO_DATA_FILE=

# --- Mentor recruitment (admin-only) -------------------------------------------
# Apollo.io API key scoped to people search + people enrichment (or a master key).
# Without it, demo mode uses the MOCK adapter; Supabase mode shows "not configured".
APOLLO_API_KEY=
# "true" forces the fictional MOCK Apollo adapter even if a key is set.
APOLLO_MOCK=
# Outreach sending stays OFF until all of these are set AND an admin switches it on.
# Uses RESEND_API_KEY (above) plus a sender on a domain verified in Resend:
OUTREACH_FROM_EMAIL=
OUTREACH_REPLY_TO=
# Hard cap on messages per batch (1–50, default 25). Admins set a lower limit in the UI.
OUTREACH_MAX_BATCH=
# Resend webhook signing secret (whsec_…) for bounces/complaints → /api/webhooks/resend
RESEND_WEBHOOK_SECRET=
# Server-only Supabase secret key, used ONLY by the webhook (no user session there).
SUPABASE_SECRET_KEY=
