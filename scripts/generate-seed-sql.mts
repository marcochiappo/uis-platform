// Generates supabase/seed.sql from the fictional demo data in src/lib/data/seed.ts.
// Run with: npm run db:seed:generate
import { writeFileSync } from "node:fs";
import path from "node:path";
import {
  seedAccounts,
  seedEvents,
  seedProspects,
  seedProviders,
  seedRequests,
  seedStudents,
} from "../src/lib/data/seed.ts";

const DEMO_PASSWORD = "uis-demo-password";

const q = (v: unknown): string => {
  if (v === null || v === undefined) return "null";
  if (typeof v === "boolean" || typeof v === "number") return String(v);
  return `'${String(v).replace(/'/g, "''")}'`;
};
const arr = (xs: readonly string[], type = "text") =>
  `array[${xs.map(q).join(", ")}]::${type}[]`;

const out: string[] = [
  "-- FICTIONAL DEMO DATA — generated by scripts/generate-seed-sql.ts. Do not edit by hand.",
  "-- Every person, email and request here is invented. Emails use the reserved .example domain.",
  `-- All demo accounts share the password '${DEMO_PASSWORD}'. Never load this into production.`,
  "",
];

for (const a of seedAccounts) {
  out.push(
    `insert into auth.users (instance_id, id, aud, role, email, encrypted_password, email_confirmed_at, raw_app_meta_data, raw_user_meta_data, confirmation_token, recovery_token, email_change, email_change_token_new, created_at, updated_at)
values ('00000000-0000-0000-0000-000000000000', ${q(a.id)}, 'authenticated', 'authenticated', ${q(a.email)}, crypt(${q(DEMO_PASSWORD)}, gen_salt('bf')), now(), '{"provider":"email","providers":["email"]}', ${q(JSON.stringify({ full_name: a.fullName }))}, '', '', '', '', ${q(a.createdAt)}, ${q(a.createdAt)});`,
    `insert into auth.identities (id, user_id, provider_id, provider, identity_data, last_sign_in_at, created_at, updated_at)
values (${q(a.id)}, ${q(a.id)}, ${q(a.id)}, 'email', ${q(JSON.stringify({ sub: a.id, email: a.email, email_verified: true }))}, now(), now(), now());`,
    `update public.profiles set role = ${q(a.role)}, linkedin_url = ${q(a.linkedinUrl)}, is_demo = true where id = ${q(a.id)};`,
  );
}
out.push("");

for (const s of seedStudents) {
  out.push(
    `insert into public.student_profiles (user_id, full_name, university, degree, degree_level, study_year, preferred_language, languages, time_zone, goals, interests, seeking, subjects, career_areas, availability, is_demo)
values (${q(s.userId)}, ${q(s.fullName)}, ${q(s.university)}, ${q(s.degree)}, ${q(s.degreeLevel)}, ${q(s.studyYear)}, ${q(s.preferredLanguage)}, ${arr(s.languages)}, ${q(s.timeZone)}, ${arr(s.goals)}, ${arr(s.interests)}, ${q(s.seeking)}, ${arr(s.subjects)}, ${arr(s.careerAreas)}, ${arr(s.availability)}, true);`,
  );
}
out.push("");

for (const p of seedProviders) {
  out.push(
    `insert into public.provider_profiles (user_id, full_name, headline, bio, expertise, offers_mentoring, offers_tutoring, tutoring_subjects, teaching_levels, mentoring_topics, career_areas, career_experience, years_experience, languages, time_zone, availability, max_active_mentees, directory_consent, is_paused, review_status, review_note, is_demo)
values (${q(p.userId)}, ${q(p.fullName)}, ${q(p.headline)}, ${q(p.bio)}, ${arr(p.expertise)}, ${q(p.offersMentoring)}, ${q(p.offersTutoring)}, ${arr(p.tutoringSubjects)}, ${arr(p.teachingLevels, "public.teaching_level")}, ${arr(p.mentoringTopics)}, ${arr(p.careerAreas)}, ${q(p.careerExperience)}, ${p.yearsExperience}, ${arr(p.languages)}, ${q(p.timeZone)}, ${arr(p.availability)}, ${p.maxActiveMentees}, ${q(p.directoryConsent)}, ${q(p.isPaused)}, ${q(p.reviewStatus)}, ${q(p.reviewNote)}, true);`,
  );
}
out.push("");

for (const r of seedRequests) {
  out.push(
    `insert into public.intro_requests (id, student_id, provider_id, service, message, status, match_score, match_reasons, created_at, updated_at, responded_at, introduced_at, closed_at)
values (${q(r.id)}, ${q(r.studentId)}, ${q(r.providerId)}, ${q(r.service)}, ${q(r.message)}, ${q(r.status)}, ${r.matchScore}, ${arr(r.matchReasons)}, ${q(r.createdAt)}, ${q(r.updatedAt)}, ${q(r.respondedAt)}, ${q(r.introducedAt)}, ${q(r.closedAt)});`,
  );
}
for (const e of seedEvents) {
  out.push(
    `insert into public.request_events (request_id, from_status, to_status, actor_id, note, created_at) values (${q(e.requestId)}, ${q(e.fromStatus)}, ${q(e.toStatus)}, ${q(e.actorId)}, ${q(e.note)}, ${q(e.createdAt)});`,
  );
}
out.push("");

for (const p of seedProspects) {
  out.push(
    `insert into public.prospects (id, full_name, email, organization, title, location, expertise, linkedin_url, notes, source, source_ref, source_detail, retrieved_at, status, review_status, review_note, email_status, email_source, enrichment_status, community_affiliation, affiliation_evidence, affiliation_reviewed_by, affiliation_reviewed_at, community_signals, do_not_contact, imported_by, created_at, updated_at)
values (${q(p.id)}, ${q(p.fullName)}, ${q(p.email)}, ${q(p.organization)}, ${q(p.title)}, ${q(p.location)}, ${q(p.expertise)}, ${q(p.linkedinUrl)}, ${q(p.notes)}, ${q(p.source)}, ${q(p.sourceRef)}, ${q(p.sourceDetail)}, ${q(p.retrievedAt)}, ${q(p.status)}, ${q(p.reviewStatus)}, ${q(p.reviewNote)}, ${q(p.emailStatus)}, ${q(p.emailSource)}, ${q(p.enrichmentStatus)}, ${q(p.communityAffiliation)}, ${q(p.affiliationEvidence)}, ${q(p.affiliationReviewedBy)}, ${q(p.affiliationReviewedAt)}, ${q(JSON.stringify(p.communitySignals))}::jsonb, ${q(p.doNotContact)}, ${q(p.importedBy)}, ${q(p.createdAt)}, ${q(p.updatedAt)});`,
  );
}

const file = path.join(import.meta.dirname, "../supabase/seed.sql");
writeFileSync(file, out.join("\n") + "\n");
console.log(`Wrote ${path.relative(process.cwd(), file)}`);
